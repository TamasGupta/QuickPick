# ============================================================
# GrabOn environment variables
# Copy this file to `.env.local` and fill in real values.
# Do NOT put real secrets in this file — it is committed to git.
# ============================================================

# --- Supabase ---
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key is SERVER-ONLY. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Razorpay ---
# From Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Flat delivery fee (in rupees) used at checkout in v1
NEXT_PUBLIC_DELIVERY_FEE=25
# Flat platform/handling fee (in rupees), shown as its own "Other charges" line
NEXT_PUBLIC_OTHER_CHARGES=15
NEXT_PUBLIC_MIN_ORDER=99

# --- Cloudinary (seller-uploaded product photos) ---
# From your Cloudinary dashboard: Settings → API Keys. Server-only — never
# prefix with NEXT_PUBLIC_, uploads go through /api/products/[id]/image so
# the secret never reaches the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Apify (auto-fetched product images via Google Images Scraper) ---
# From your Apify account: Settings → Integrations → API tokens.
# Server-only — do NOT prefix with NEXT_PUBLIC_. Leave unset to disable
# auto-image lookup (products just import without a photo).
APIFY_API_TOKEN=

# --- Cron (stale pending-order cleanup, see vercel.json) ---
# Any random string. Set the SAME value in Vercel's project env vars — Vercel
# Cron then sends it automatically as `Authorization: Bearer <value>` on each
# triggered request. Leave unset locally to run the route unauthenticated
# (fine for local testing only).
CRON_SECRET=

# --- TEMPORARY: static OTP fallback ---
# When enabled, EVERY email logs in with this one shared code instead of a
# real per-user OTP. See src/app/api/auth/static-login/route.ts.
#
# Set this to false (or unset it) once real email OTP delivery is set up —
# the code path for that already exists (supabase.auth.signInWithOtp/
# verifyOtp with type "email" in login/page.tsx and register/page.tsx), but
# it only actually delivers once BOTH of these are done on the Supabase
# project's dashboard (not in this codebase):
#   1. Authentication → Emails → SMTP Settings — configure a real provider
#      (e.g. Resend: host smtp.resend.com, port 587, user "resend", password
#      = your Resend API key). Supabase's built-in mailer is rate-limited
#      and not meant for production.
#   2. Authentication → Emails → Templates → Magic Link — the default
#      template only shows a clickable link; add {{ .Token }} so it shows
#      the 6-digit code this app's UI asks users to type. See
#      supabase/templates/otp-email.html for a ready-to-paste version.
NEXT_PUBLIC_STATIC_OTP_ENABLED=false
STATIC_OTP_CODE=

# --- WhatsApp OTP (Meta Cloud API) ---
# Real per-user login/register OTP delivered via WhatsApp instead of SMS —
# Supabase Auth's phone provider has no WhatsApp channel, so this bypasses it
# entirely (see lib/whatsapp.ts, lib/otp.ts, /api/auth/whatsapp/*).
# WHATSAPP_PHONE_NUMBER_ID / WHATSAPP_ACCESS_TOKEN come from your Meta App's
# WhatsApp > API Setup page — use a permanent System User token for
# production, the dashboard's default token expires in 24h.
# WHATSAPP_OTP_TEMPLATE_NAME is the name of your approved Authentication-
# category template (defaults to "otp_login" if unset).
# STATIC_MODE above always wins if both are left on, so local dev never
# silently depends on live WhatsApp delivery.
NEXT_PUBLIC_WHATSAPP_OTP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE_NAME=otp_login

# --- Web Push notifications ---
# Generate once with `npx web-push generate-vapid-keys` — identifies this
# app to push services (browser vendors), not per-user secrets. Safe to keep
# stable across environments; rotating them invalidates every existing
# subscription (every user would need to re-subscribe).
# VAPID_SUBJECT must be a mailto: address or https: URL a push service can
# use to contact you if something's wrong with your usage — required by the
# Web Push protocol, not optional.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
