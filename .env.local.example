# ============================================================
# GrabOn environment variables
# Copy this file to `.env.local` and fill in real values.
# Do NOT put real secrets in this file — it is committed to git.
# ============================================================

# --- Supabase ---
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key is SERVER-ONLY. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Razorpay ---
# From Razorpay Dashboard → Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Flat delivery fee (in rupees) used at checkout in v1
NEXT_PUBLIC_DELIVERY_FEE=25
NEXT_PUBLIC_MIN_ORDER=99

# --- Apify (auto-fetched product images via Google Images Scraper) ---
# From your Apify account: Settings → Integrations → API tokens.
# Server-only — do NOT prefix with NEXT_PUBLIC_. Leave unset to disable
# auto-image lookup (products just import without a photo).
APIFY_API_TOKEN=

# --- Cron (stale pending-order cleanup, see vercel.json) ---
# Any random string. Set the SAME value in Vercel's project env vars — Vercel
# Cron then sends it automatically as `Authorization: Bearer <value>` on each
# triggered request. Leave unset locally to run the route unauthenticated
# (fine for local testing only).
CRON_SECRET=

# --- TEMPORARY: static OTP fallback (leave unset/false once real SMS works) ---
# When enabled, EVERY phone number logs in with this one shared code instead
# of a real per-user OTP. See src/app/api/auth/static-login/route.ts.
NEXT_PUBLIC_STATIC_OTP_ENABLED=false
STATIC_OTP_CODE=
